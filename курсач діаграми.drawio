        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n  direction TB\n  [*] --&gt; Очікує_підтвердження : Створення заявки\n\n  state \&quot;Очікує підтвердження\&quot; as Очікує_підтвердження {\n    [*] --&gt; Очікування_рішення\n    state \&quot;do / Очікування рішення консультанта\&quot; as Очікування_рішення\n  }\n\n  state \&quot;Підтверджена\&quot; as Підтверджена {\n    [*] --&gt; Очікування_дати\n    state \&quot;do / Очікування дати проведення консультації\&quot; as Очікування_дати\n  }\n\n  state \&quot;Завершена\&quot; as Завершена {\n    [*] --&gt; Збереження_результату\n    state \&quot;entry / Збереження результату консультації\&quot; as Збереження_результату\n  }\n\n  Очікує_підтвердження --&gt; Підтверджена : Підтвердження консультантом\n  Очікує_підтвердження --&gt; Відхилена : Відхилення консультантом\n  Очікує_підтвердження --&gt; Скасована_клієнтом : Скасування клієнтом\n  Підтверджена --&gt; Скасована_клієнтом : Скасування клієнтом\n  Підтверджена --&gt; Скасована_консультантом : Скасування консультантом\n  Підтверджена --&gt; Завершена : Завершення консультації\n\n  state \&quot;Відхилена\&quot; as Відхилена\n  state \&quot;Скасована клієнтом\&quot; as Скасована_клієнтом\n  state \&quot;Скасована консультантом\&quot; as Скасована_консультантом\n\n  Відхилена --&gt; [*]\n  Скасована_клієнтом --&gt; [*]\n  Скасована_консультантом --&gt; [*]\n  Завершена --&gt; [*]\n\n  note right of Очікує_підтвердження\n    Життєвий цикл консультації\n  end note&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="QrBt022HW2jWnUOXi2IX-168">
