        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  direction TB\n\n  class User {\n    &lt;&lt;abstract&gt;&gt;\n    +Guid Id\n    +string Name\n    +string Email\n    +string PasswordHash\n    +DateTime CreatedAt\n    +Login() bool\n    +UpdateProfile() void\n  }\n\n  class Client {\n    +DateTime BirthDate\n    +CreateReading() Reading\n    +ViewHistory() List~Reading~\n  }\n\n  class Consultant {\n    +string Description\n    +double Rating\n    +CreateConsultation() Consultation\n  }\n\n  class Admin {\n    +ManageUsers() void\n    +ModerateReviews() void\n  }\n\n  class Reading {\n    +Guid Id\n    +string Question\n    +DateTime CreatedAt\n    +string Conclusion\n    +GenerateCards() void\n    +Save() void\n  }\n\n  class TarotCard {\n    +Guid Id\n    +string Name\n    +string Image\n    +string Meaning\n    +bool IsReversed\n    +GetInterpretation() string\n  }\n\n  class AIInterpretation {\n    +Guid Id\n    +string CardInterpretations\n    +string GeneralConclusion\n    +AnalyzeCards() void\n    +GenerateConclusion() string\n  }\n\n  class DestinyMatrix {\n    +Guid Id\n    +DateTime BirthDate\n    +string CalculationResult\n    +Calculate() void\n    +Save() void\n  }\n\n  class Consultation {\n    +Guid Id\n    +DateTime Date\n    +string Status\n    +Create() void\n    +Cancel() void\n  }\n\n  class Review {\n    +Guid Id\n    +int Rating\n    +string Comment\n    +DateTime CreatedAt\n    +AddReview() void\n  }\n\n  class Message {\n    +Guid Id\n    +string Content\n    +DateTime SentAt\n    +Send() void\n  }\n\n  User &lt;|-- Client\n  User &lt;|-- Consultant\n  User &lt;|-- Admin\n\n  Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Reading\n  Reading \&quot;1\&quot; *-- \&quot;*\&quot; TarotCard\n  Reading \&quot;1\&quot; --&gt; \&quot;1\&quot; AIInterpretation\n\n  Client \&quot;1\&quot; --&gt; \&quot;*\&quot; DestinyMatrix\n  Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Consultation\n  Consultant \&quot;1\&quot; --&gt; \&quot;*\&quot; Consultation\n\n  Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Review\n  Consultant \&quot;1\&quot; --&gt; \&quot;*\&quot; Review\n  Consultation \&quot;1\&quot; *-- \&quot;*\&quot; Message&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="QrBt022HW2jWnUOXi2IX-527">
